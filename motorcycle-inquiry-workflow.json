              "requiredField": true
            },
            {
              "fieldLabel": "Budget",
              "fieldType": "number",
              "requiredField": true
            },
            {
              "fieldLabel": "Purchase timeline",
              "fieldType": "dropdown",
              "fieldOptions": {
                "values": [
                  {
                    "option": "Within 7 days"
                  },
                  {
                    "option": "Within 30 days"
                  },
                  {
                    "option": "Just browsing"
                  }
                ]
              },
              "requiredField": true
            },
            {
              "fieldLabel": "Message",
              "fieldType": "textarea"
            }
          ]
        },
        "options": {}
