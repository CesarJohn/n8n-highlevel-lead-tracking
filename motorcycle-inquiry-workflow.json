      "parameters": {
        "formTitle": "Motorcycle Inquiry Form",
        "formDescription": "Interested in a motorcycle? Submit your details and we’ll contact you.",
        "formFields": {
          "values": [
            {
              "fieldLabel": "Name",
              "requiredField": true
            },
            {
              "fieldLabel": "Email",
              "fieldType": "email",
