    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const data = $json;\n\nconst name = String(data.Name ?? '').trim();\nconst email = String(data.Email ?? '').trim().toLowerCase();\nconst motorcycle = String(data['Motorcycle of interest'] ?? '').trim();\nconst budget = Number(data.Budget);\nconst timeline = String(data['Purchase timeline'] ?? '').trim();\n\nif (!name) throw new Error('Name is required.');\n\nif (!/^[^\\s@]+@[^\\s@]+\\.[^\\s@]+$/.test(email)) {\n  throw new Error('Enter a valid email address.');\n}\n\nif (!motorcycle) throw new Error('Motorcycle is required.');\n\nif (!Number.isFinite(budget) || budget <= 0) {\n  throw new Error('Budget must be a number greater than zero.');\n}\n\nif (!['Within 7 days', 'Within 30 days', 'Just browsing'].includes(timeline)) {\n  throw new Error('Select a valid purchase timeline.');\n}\n\nreturn {\n  json: {\n    name,\n    email,\n    motorcycle,\n    budget,\n    timeline,\n    message: String(data.Message ?? '').trim(),\n    submittedAt: data.submittedAt\n  }\n};"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
