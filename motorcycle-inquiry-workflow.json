    {
      "parameters": {
        "jsCode": "const contact = $('Create or update a contact').first().json;\nconst inquiry = $('Validate Fields').first().json;\n\nif (!contact.id) {\n  throw new Error('Missing contact ID.');\n}\n\nconst opportunities = $input.all().flatMap(item =>\n  Array.isArray(item.json.opportunities)\n    ? item.json.opportunities\n    : [item.json]\n);\n\nconst match = opportunities.find(opportunity =>\n  opportunity.id &&\n  (opportunity.contactId ?? opportunity.contact?.id) === contact.id &&\n  opportunity.status === 'open'\n);\n\nreturn [{\n  json: {\n    ...inquiry,\n    contactId: contact.id,\n    opportunityExists: Boolean(match),\n    opportunityId: match?.id ?? null\n  }\n}];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
