    {
      "parameters": {
        "jsCode": "const contact = $('Create or update a contact').first().json;\n\nconst tasks = $input.all().flatMap(item =>\n  Array.isArray(item.json.tasks)\n    ? item.json.tasks\n    : [item.json]\n);\n\nconst existingTask = tasks.find(task =>\n  task.id &&\n  String(task.title ?? '').trim().toLowerCase() ===\n    'follow up on motorcycle inquiry' &&\n  task.completed !== true\n);\n\nreturn [{\n  json: {\n    contactId: contact.id,\n    taskExists: Boolean(existingTask),\n    taskId: existingTask?.id ?? null\n  }\n}];"
      },
